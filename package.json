{
  "name": "rova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/main.ts",
  "scripts": {
    "dev": "bun run --watch src/main.ts serve",
    "dev:worker": "bun run --watch src/main.ts worker",
    "build": "bun run scripts/build.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/main.ts migrate",
    "db:seed": "bun run src/main.ts seed",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
