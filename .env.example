# Postgres (matches docker-compose.yml defaults for local dev — port 5544
# to avoid clashing with other local Postgres containers on 5432/5433)
DATABASE_URL=postgres://rova:rova@localhost:5544/rova

# Session cookie signing — generate with: openssl rand -base64 32
SESSION_SECRET=

# LLM providers
ANTHROPIC_API_KEY=
# Default is claude-opus-5. Override to e.g. claude-sonnet-5 to cut ranking
# cost — see src/ranking/claude.ts for the per-run cost guardrails.
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=

# Embeddings provider: "openai" (needs OPENAI_API_KEY) or "ollama" (local,
# free, needs `ollama serve` running + the model pulled — see below).
# Both produce 768-dim vectors (OpenAI truncated via its `dimensions`
# param) so they're interchangeable — see src/db/schema/jobs.ts.
EMBEDDINGS_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Per-job one-sentence summary (shown on job cards). "ollama" (local,
# free — needs the chat model pulled: `ollama pull llama3.2:3b`) or
# "claude" (better quality/consistency, needs ANTHROPIC_API_KEY above).
SUMMARIZATION_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.2:3b

# Email delivery (digests)
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@example.com

# Crawl-failure alerts (optional — logs a warning instead if unset)
ADMIN_EMAIL=

# Server
PORT=3000
NODE_ENV=development
